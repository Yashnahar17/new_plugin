{
    "name": "astrax/astrax-addons",
    "description": "Astrax Addons for Elementor",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "AstraxAddons\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstraxAddons\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyze": "phpstan analyse includes"
    }
}
