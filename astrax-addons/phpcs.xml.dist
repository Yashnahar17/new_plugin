<?xml version="1.0"?>
<ruleset name="AstraxAddons">
    <description>Coding standards for Astrax Addons</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="s"/>

    <!-- Check all files in this directory and subdirectories -->
    <file>.</file>

    <!-- Exclude common directories -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>

    <!-- Use WordPress coding standards -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!-- Ensure text domain matches -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="astrax-addons"/>
        </properties>
    </rule>

    <!-- Ignore filename constraints for PSR-4 classes -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>includes/*</exclude-pattern>
    </rule>
</ruleset>
